      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1100, 100], "onError": "continueErrorOutput",
      "id": "c5000300-0000-4000-8000-000000000016", "name": "Check Video Status"
    },
    {
      "parameters": {"jsCode": "const prior=$('Wait for Render').item.json; const data=$json.data ?? $json; const provider_status=String(data.status??'processing').toLowerCase(); const poll_attempt=Number(prior.poll_attempt??0)+1; let status='processing'; if(provider_status==='completed') status='completed'; else if(['failed','error'].includes(provider_status)) status='review_required'; else if(poll_attempt>=Number(prior.maximum_poll_attempts??20)) status='review_required'; return [{json:{...prior,provider_status,status,poll_attempt,attempts:poll_attempt,video_url:String(data.video_url??''),thumbnail_url:String(data.thumbnail_url??''),error_class:status==='review_required'?(provider_status==='failed'?'provider_failed':'poll_timeout'):''}}];"},
