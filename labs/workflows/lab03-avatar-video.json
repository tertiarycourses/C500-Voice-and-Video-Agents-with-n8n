    {
      "parameters": {"jsCode": "const source=$('Campaign Profile').first().json; const video_id=String($json.data?.video_id ?? $json.video_id ?? '').trim(); if(!video_id) throw new Error('CREATE_RESPONSE_MISSING_VIDEO_ID'); return [{json:{brief_id:source.brief_id,approved_script:source.approved_script,approved_script_hash:source.approved_script_hash,script_hash:source.computed_script_hash,approved_disclosure:source.approved_disclosure,profile_version:source.profile_version,destination:source.destination,video_id,poll_attempt:0,maximum_poll_attempts:source.maximum_poll_attempts,created_at:new Date().toISOString()}}];"},
