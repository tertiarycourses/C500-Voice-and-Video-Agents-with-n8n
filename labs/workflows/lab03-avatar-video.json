      "parameters": {"jsCode": "const b=$json.body ?? $json;\nconst action=String(b.action ?? '').trim().toLowerCase();\nlet request_ok=['draft','render'].includes(action); let error_class=request_ok?'':'invalid_action';\nif(action==='draft'){ const facts=Array.isArray(b.approved_facts)?b.approved_facts:[]; const words=Number(b.max_words); request_ok=Boolean(b.brief_id&&b.audience&&b.objective&&b.call_to_action&&facts.length&&words>=30&&words<=90); if(!request_ok) error_class='invalid_draft_request'; }\nif(action==='render'){ request_ok=Boolean(b.brief_id&&b.approved_script&&b.approved_script_hash&&b.approved_disclosure&&b.approved_for_render===true); if(!request_ok) error_class='invalid_render_request'; }\nreturn [{json:{...b,action,request_ok,error_class}}];"},
