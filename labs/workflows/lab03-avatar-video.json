    {
      "parameters": {"jsCode": "const b=$json; const script=String(b.approved_script??''); const supplied=String(b.approved_script_hash??'').toLowerCase(); const disclosure=String(b.approved_disclosure??'').trim(); const approval_input_ok=Boolean(b.approved_for_render===true&&script.trim()&&disclosure&&/^[a-f0-9]{64}$/.test(supplied)); return [{json:{...b,approved_script_hash:supplied,approved_disclosure:disclosure,approval_input_ok,status:'approval_mismatch',error_class:'approval_mismatch'}}];"},
