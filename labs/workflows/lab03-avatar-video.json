      "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [-620, 0],
      "id": "c5000300-0000-4000-8000-000000000004", "name": "Is Draft Request"
    },
    {
      "parameters": {"promptType": "define", "text": "=Audience: {{$json.audience}}\nObjective: {{$json.objective}}\nApproved facts: {{JSON.stringify($json.approved_facts)}}\nCall to action: {{$json.call_to_action}}\nMaximum spoken words: {{$json.max_words}}", "options": {"systemMessage": "You prepare a short HarbourStay synthetic training video draft. Use only the supplied approved facts. Return one JSON object with title, spoken_script, caption, claim_list and disclosure. claim_list must contain only exact supplied facts used. disclosure must say the video uses an AI avatar. Do not invent prices, availability, testimonials, guarantees or booking-specific facts. Keep spoken_script within the supplied word limit. Do not wrap the JSON in prose."}},
      "type": "@n8n/n8n-nodes-langchain.agent", "typeVersion": 3.1, "position": [-380, -220],
