    },
    {
      "parameters": {"jsCode": "const source=$('Validate Request').first().json; const output=String($json.output ?? '').trim();\nconst first=output.indexOf('{'); const last=output.lastIndexOf('}'); let draft={};\ntry{ draft=JSON.parse(first>=0&&last>first?output.slice(first,last+1):output); }catch{}\nconst script=String(draft.spoken_script ?? '').trim(); const claims=Array.isArray(draft.claim_list)?draft.claim_list:[]; const facts=source.approved_facts.map(String);\nconst word_count=script?script.split(/\\s+/).length:0; const disclosure=String(draft.disclosure??'').trim(); const script_contract_ok=Boolean(script&&word_count<=Number(source.max_words)&&claims.every(c=>facts.includes(String(c)))&&disclosure);\nreturn [{json:{status:script_contract_ok?'draft_ready':'draft_rejected',brief_id:source.brief_id,spoken_script:script,title:String(draft.title??''),caption:String(draft.caption??''),claim_list:claims,disclosure,profile_id:'c500-demo-1',word_count,script_contract_ok,error_class:script_contract_ok?'':'script_contract_failed'}}];"},
