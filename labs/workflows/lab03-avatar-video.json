    {
      "parameters": {"jsCode": "let video_id=''; let brief_id=''; let script_hash=''; let profile_version=''; let attempts=0; try{const w=$('Wait for Render').item.json; video_id=String(w.video_id??''); brief_id=String(w.brief_id??''); script_hash=String(w.script_hash??''); profile_version=String(w.profile_version??''); attempts=Number(w.poll_attempt??0);}catch{} try{const s=$('Campaign Profile').first().json; brief_id=brief_id||String(s.brief_id??''); script_hash=script_hash||String(s.computed_script_hash??s.approved_script_hash??''); profile_version=profile_version||String(s.profile_version??'');}catch{} const detail=String($json.message??$json.error?.message??$json.error??'provider_request_failed'); return [{json:{status:'review_required',error_class:'provider_request_failed',error_detail:detail.slice(0,240),brief_id,script_hash,profile_version,video_id,attempts}}];"},
