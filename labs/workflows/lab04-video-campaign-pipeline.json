    {
      "parameters": {"resource": "row", "operation": "get", "dataTableId": {"__rl": true, "value": "c500_campaign_queue", "mode": "name"}, "matchType": "allConditions", "filters": {"conditions": [{"keyName": "campaign_id", "condition": "eq", "keyValue": "c500-weekly-tip-001"}]}, "returnAll": false, "limit": 1},
      "type": "n8n-nodes-base.dataTable", "typeVersion": 1.1, "position": [-1260, 20],
      "id": "c5000400-0000-4000-8000-000000000003", "name": "Get Approved Campaign"
    },
    {
      "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2}, "conditions": [{"id": "approved", "leftValue": "={{ $json.approval_status }}", "rightValue": "approved", "operator": {"type": "string", "operation": "equals"}}], "combinator": "and"}, "options": {}},
      "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [-1040, 20],
      "id": "c5000400-0000-4000-8000-000000000004", "name": "Approval Gate"
    },
    {
      "parameters": {"jsCode": "return [{json:{status:'skipped_unapproved',campaign_id:String($json.campaign_id??''),external_calls:0}}];"},
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-800, 220],
      "id": "c5000400-0000-4000-8000-000000000005", "name": "Record Unapproved Skip"
    },
    {
      "parameters": {"assignments": {"assignments": [
        {"id": "avatar", "name": "avatar_id", "value": "<HEYGEN_AVATAR_ID>", "type": "string"},
        {"id": "voice", "name": "voice_id", "value": "<HEYGEN_VOICE_ID>", "type": "string"},
        {"id": "profile", "name": "profile_version", "value": "c500-demo-1", "type": "string"},
        {"id": "poll", "name": "poll_seconds", "value": 15, "type": "number"},
        {"id": "attempts", "name": "maximum_poll_attempts", "value": 20, "type": "number"},
        {"id": "volume", "name": "maximum_videos_per_run", "value": 1, "type": "number"},
        {"id": "request-key", "name": "request_key", "value": "={{ 'c500-video:' + $json.campaign_id }}", "type": "string"}
      ]}, "includeOtherFields": true, "options": {}},
      "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [-800, -80],
      "id": "c5000400-0000-4000-8000-000000000006", "name": "Pipeline Configuration"
    },
    {
      "parameters": {"jsCode": "const script=String($json.approved_script??''); const supplied=String($json.approved_script_hash??'').toLowerCase(); const snapshot_fields_ok=Boolean(script.trim()&&/^[a-f0-9]{64}$/.test(supplied)&&String($json.approved_profile_version??'')===String($json.profile_version??'')&&String($json.approved_destination_id??'').trim()&&Number($json.maximum_videos_per_run)===1); return [{json:{...$json,approved_script_hash:supplied,snapshot_fields_ok,error_class:'approval_snapshot_mismatch'}}];"},
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-560, -80],
      "id": "c5000400-0000-4000-8000-000000000007", "name": "Validate Approved Snapshot"
    },
    {
      "parameters": {"type": "SHA256", "value": "={{ $json.approved_script }}", "dataPropertyName": "script_hash"},
      "type": "n8n-nodes-base.crypto", "typeVersion": 1, "position": [-440, -80],
      "id": "c5000400-0000-4000-8000-000000000029", "name": "Hash Queue Script"
    },
    {
      "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2}, "conditions": [{"id": "snapshot-fields", "leftValue": "={{ $json.snapshot_fields_ok }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}, {"id": "snapshot-hash", "leftValue": "={{ $json.script_hash }}", "rightValue": "={{ $json.approved_script_hash }}", "operator": {"type": "string", "operation": "equals"}}], "combinator": "and"}, "options": {}},
      "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [-320, -80],
      "id": "c5000400-0000-4000-8000-000000000008", "name": "Approved Snapshot Valid"
    },
    {
      "parameters": {"jsCode": "return [{json:{status:'snapshot_rejected',campaign_id:$json.campaign_id,error_class:$json.error_class,external_calls:0}}];"},
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-80, 180],
      "id": "c5000400-0000-4000-8000-000000000009", "name": "Record Snapshot Rejection"
    },
    {
      "parameters": {"resource": "row", "operation": "get", "dataTableId": {"__rl": true, "value": "c500_campaign_runs", "mode": "name"}, "matchType": "allConditions", "filters": {"conditions": [{"keyName": "request_key", "condition": "eq", "keyValue": "={{ $json.request_key }}"}]}, "returnAll": false, "limit": 1},
      "type": "n8n-nodes-base.dataTable", "typeVersion": 1.1, "position": [-80, -80], "alwaysOutputData": true,
      "id": "c5000400-0000-4000-8000-000000000010", "name": "Find Existing Run"
    },
    {
      "parameters": {"jsCode": "const source=$('Hash Queue Script').first().json; const existing_key=String($json.request_key??''); return [{json:{...source,existing_run:Boolean(existing_key),existing_status:String($json.status??''),existing_video_id:String($json.video_id??'')}}];"},
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [160, -80],
      "id": "c5000400-0000-4000-8000-000000000011", "name": "Classify Existing Run"
    },
    {
      "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2}, "conditions": [{"id": "exists", "leftValue": "={{ $json.existing_run }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}], "combinator": "and"}, "options": {}},
      "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [400, -80],
      "id": "c5000400-0000-4000-8000-000000000012", "name": "Existing Run"
    },
    {
      "parameters": {"jsCode": "return [{json:{status:'skipped_duplicate',campaign_id:$json.campaign_id,request_key:$json.request_key,existing_status:$json.existing_status,existing_video_id:$json.existing_video_id,additional_create_calls:0,additional_publish_calls:0}}];"},
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [640, 100],
      "id": "c5000400-0000-4000-8000-000000000013", "name": "Record Duplicate Skip"
    },
    {
      "parameters": {"resource": "row", "operation": "insert", "dataTableId": {"__rl": true, "value": "c500_campaign_runs", "mode": "name"}, "columns": {"mappingMode": "defineBelow", "value": {"campaign_id": "={{ $json.campaign_id }}", "request_key": "={{ $json.request_key }}", "status": "rendering", "video_id": "", "video_url": "", "destination_id": "={{ $json.approved_destination_id }}", "message_id": "", "attempts": 0, "script_hash": "={{ $json.script_hash }}", "profile_version": "={{ $json.profile_version }}", "started_at": "={{ $now }}", "error_class": ""}, "matchingColumns": [], "schema": [], "attemptToConvertTypes": false, "convertFieldsToString": false}, "options": {}},
      "type": "n8n-nodes-base.dataTable", "typeVersion": 1.1, "position": [640, -160],
      "id": "c5000400-0000-4000-8000-000000000014", "name": "Insert Run Ledger"
    },
    {
      "parameters": {"method": "POST", "url": "https://api.heygen.com/v2/video/generate", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "contentType": "raw", "rawContentType": "application/json", "body": "={{ JSON.stringify({video_inputs:[{character:{type:'avatar',avatar_id:$('Validate Approved Snapshot').first().json.avatar_id},voice:{type:'text',input_text:$('Validate Approved Snapshot').first().json.approved_script,voice_id:$('Validate Approved Snapshot').first().json.voice_id}}],dimension:{width:1280,height:720},caption:true}) }}", "options": {}},
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [880, -160], "onError": "continueErrorOutput",
      "id": "c5000400-0000-4000-8000-000000000015", "name": "Create Avatar Video"
    },
    {
      "parameters": {"resource": "row", "operation": "update", "dataTableId": {"__rl": true, "value": "c500_campaign_runs", "mode": "name"}, "matchType": "allConditions", "filters": {"conditions": [{"keyName": "request_key", "condition": "eq", "keyValue": "={{ $('Validate Approved Snapshot').first().json.request_key }}"}]}, "columns": {"mappingMode": "defineBelow", "value": {"video_id": "={{ $json.data.video_id }}", "status": "rendering", "attempts": 0}, "matchingColumns": [], "schema": [], "attemptToConvertTypes": false, "convertFieldsToString": false}, "options": {}},
      "type": "n8n-nodes-base.dataTable", "typeVersion": 1.1, "position": [1120, -160],
      "id": "c5000400-0000-4000-8000-000000000016", "name": "Store Provider Video ID"
    },
    {
      "parameters": {"amount": 15, "unit": "seconds"},
      "type": "n8n-nodes-base.wait", "typeVersion": 1.1, "position": [1360, -160],
      "id": "c5000400-0000-4000-8000-000000000017", "name": "Wait for Render", "webhookId": "c500-lab04-wait"
    },
    {
      "parameters": {"url": "https://api.heygen.com/v1/video_status.get", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendQuery": true, "queryParameters": {"parameters": [{"name": "video_id", "value": "={{ $json.video_id }}"}]}, "options": {}},
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1600, -160], "onError": "continueErrorOutput",
      "id": "c5000400-0000-4000-8000-000000000018", "name": "Check Video Status"
    },
    {
      "parameters": {"jsCode": "const prior=$('Wait for Render').item.json; const data=$json.data??$json; const provider_status=String(data.status??'processing').toLowerCase(); const attempts=Number(prior.attempts??0)+1; const maximum=Number($('Validate Approved Snapshot').first().json.maximum_poll_attempts??20); let status='processing'; let error_class=''; if(provider_status==='completed') status='completed'; else if(['failed','error'].includes(provider_status)){status='review_required';error_class='provider_failed';} else if(attempts>=maximum){status='review_required';error_class='poll_timeout';} return [{json:{...prior,provider_status,status,attempts,video_url:String(data.video_url??''),error_class}}];"},
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1840, -160],
      "id": "c5000400-0000-4000-8000-000000000019", "name": "Route Status"
    },
    {
      "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2}, "conditions": [{"id": "completed", "leftValue": "={{ $json.status }}", "rightValue": "completed", "operator": {"type": "string", "operation": "equals"}}], "combinator": "and"}, "options": {}},
      "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [2080, -160],
      "id": "c5000400-0000-4000-8000-000000000020", "name": "Is Completed"
    },
    {
      "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2}, "conditions": [{"id": "review", "leftValue": "={{ $json.status }}", "rightValue": "review_required", "operator": {"type": "string", "operation": "equals"}}], "combinator": "and"}, "options": {}},
      "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [2300, -40],
      "id": "c5000400-0000-4000-8000-000000000021", "name": "Is Review Required"
    },
    {
      "parameters": {"type": "SHA256", "value": "={{ $('Validate Approved Snapshot').first().json.approved_script }}", "dataPropertyName": "release_script_hash"},
      "type": "n8n-nodes-base.crypto", "typeVersion": 1, "position": [2240, -240],
      "id": "c5000400-0000-4000-8000-000000000030", "name": "Hash Release Script"
    },
    {
      "parameters": {"jsCode": "const approved=$('Validate Approved Snapshot').first().json; const release_ok=Boolean($json.provider_status==='completed'&&String($json.video_url??'').trim()&&String($json.release_script_hash)===String(approved.approved_script_hash)&&String(approved.profile_version)===String(approved.approved_profile_version)&&String(approved.approved_destination_id).trim()); return [{json:{...$json,approved_script_hash:approved.approved_script_hash,approved_profile_version:approved.approved_profile_version,approved_destination_id:approved.approved_destination_id,release_ok,error_class:release_ok?'':'release_check_failed'}}];"},
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2300, -240],
      "id": "c5000400-0000-4000-8000-000000000022", "name": "Release Checks"
    },
    {
      "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2}, "conditions": [{"id": "release", "leftValue": "={{ $json.release_ok }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}], "combinator": "and"}, "options": {}},
      "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [2540, -240],
      "id": "c5000400-0000-4000-8000-000000000023", "name": "Release Approved"
    },
    {
      "parameters": {"resource": "message", "operation": "sendVideo", "chatId": "={{ $json.approved_destination_id }}", "binaryData": false, "file": "={{ $json.video_url }}", "additionalFields": {"caption": "HarbourStay welcome — Generated with an AI avatar - training preview.", "appendAttribution": false}},
      "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [2780, -300], "onError": "continueErrorOutput",
      "id": "c5000400-0000-4000-8000-000000000024", "name": "Publish Private Preview"
    },
    {
      "parameters": {"resource": "row", "operation": "update", "dataTableId": {"__rl": true, "value": "c500_campaign_runs", "mode": "name"}, "matchType": "allConditions", "filters": {"conditions": [{"keyName": "request_key", "condition": "eq", "keyValue": "={{ $('Validate Approved Snapshot').first().json.request_key }}"}]}, "columns": {"mappingMode": "defineBelow", "value": {"status": "published", "video_id": "={{ $('Release Checks').first().json.video_id }}", "video_url": "={{ $('Release Checks').first().json.video_url }}", "destination_id": "={{ $('Release Checks').first().json.approved_destination_id }}", "message_id": "={{ $json.message_id || $json.result?.message_id || '' }}", "attempts": "={{ $('Release Checks').first().json.attempts }}", "script_hash": "={{ $('Release Checks').first().json.approved_script_hash }}", "profile_version": "={{ $('Release Checks').first().json.approved_profile_version }}", "completed_at": "={{ $now }}", "error_class": ""}, "matchingColumns": [], "schema": [], "attemptToConvertTypes": false, "convertFieldsToString": false}, "options": {}},
      "type": "n8n-nodes-base.dataTable", "typeVersion": 1.1, "position": [3020, -300],
      "id": "c5000400-0000-4000-8000-000000000025", "name": "Mark Published"
    },
    {
      "parameters": {"jsCode": "const approved=$('Validate Approved Snapshot').first().json; let known={}; try{known=$('Wait for Render').item.json;}catch{} const detail=String($json.message??$json.error?.message??$json.error??'provider_or_publish_failed'); return [{json:{request_key:approved.request_key,campaign_id:approved.campaign_id,status:'review_required',video_id:String(known.video_id??$json.video_id??''),video_url:String(known.video_url??$json.video_url??''),destination_id:approved.approved_destination_id,attempts:Number(known.attempts??0),script_hash:approved.approved_script_hash,profile_version:approved.approved_profile_version,error_class:String($json.error_class??'provider_or_publish_failed'),error_detail:detail.slice(0,240)}}];"},
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2080, 220],
      "id": "c5000400-0000-4000-8000-000000000026", "name": "Normalise Review State"
    },
    {
      "parameters": {"resource": "row", "operation": "update", "dataTableId": {"__rl": true, "value": "c500_campaign_runs", "mode": "name"}, "matchType": "allConditions", "filters": {"conditions": [{"keyName": "request_key", "condition": "eq", "keyValue": "={{ $json.request_key }}"}]}, "columns": {"mappingMode": "defineBelow", "value": {"status": "review_required", "video_id": "={{ $json.video_id }}", "video_url": "={{ $json.video_url }}", "destination_id": "={{ $json.destination_id }}", "attempts": "={{ $json.attempts }}", "script_hash": "={{ $json.script_hash }}", "profile_version": "={{ $json.profile_version }}", "completed_at": "={{ $now }}", "error_class": "={{ $json.error_class }}"}, "matchingColumns": [], "schema": [], "attemptToConvertTypes": false, "convertFieldsToString": false}, "options": {}},
      "type": "n8n-nodes-base.dataTable", "typeVersion": 1.1, "position": [2320, 220],
      "id": "c5000400-0000-4000-8000-000000000027", "name": "Mark Review Required"
    },
    {
      "parameters": {"content": "## C500 Lab 4 — persistent control\nCreate both named Data Tables before running. The queue holds an exact approved script, hash, profile version and private destination. Native Crypto nodes verify the hash without Code-node imports. The run ledger is inserted before one create call. All provider, timeout, release and publish failures update the same key to review_required. Keep the schedule disabled.", "height": 250, "width": 560, "color": 5},
